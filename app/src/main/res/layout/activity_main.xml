<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Titre + score -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Quiz en images"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Score : 0/5"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Progression -->
        <ProgressBar
            android:id="@+id/progress_quiz"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:max="5"
            android:progress="0" />

        <!-- Numéro de question -->
        <TextView
            android:id="@+id/txt_numero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Question 1 sur 5"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Image -->
        <ImageView
            android:id="@+id/img_question"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="16dp"
            android:adjustViewBounds="true"
            android:contentDescription="Image de la question"
            android:scaleType="fitCenter" />

        <!-- Question -->
        <TextView
            android:id="@+id/txt_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Question"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Choix 1 -->
        <Button
            android:id="@+id/btn_choix1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Choix 1" />

        <!-- Choix 2 -->
        <Button
            android:id="@+id/btn_choix2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Choix 2" />

        <!-- Choix 3 -->
        <Button
            android:id="@+id/btn_choix3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Choix 3" />

        <!-- Message de correction -->
        <TextView
            android:id="@+id/txt_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text=""
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Bouton suivant -->
        <Button
            android:id="@+id/btn_suivant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Question suivante"
            android:visibility="gone" />

        <!-- Zone résultat final -->
        <TextView
            android:id="@+id/txt_resultat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text=""
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Rejouer -->
        <Button
            android:id="@+id/btn_rejouer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Rejouer"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>